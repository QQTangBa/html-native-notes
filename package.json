{
  "name": "html-native-notes",
  "version": "0.1.0",
  "description": "Local-first HTML-native note editor with user-configured AI actions.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "APP_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:desktop:contract": "vitest run tests/unit/desktopScaffold.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/middie": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.2.6",
    "fastify": "^5.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.30.0",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
